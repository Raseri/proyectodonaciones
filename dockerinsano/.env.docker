# ──────────────────────────────────────────────
# Variables de entorno para Docker
# Copia este archivo a .env en esta misma carpeta
# y ajusta los valores antes de levantar los servicios.
# ──────────────────────────────────────────────

# Puerto del backend dentro del contenedor
PORT=3000

# Secreto para firmar tokens JWT (¡cámbialo en producción!)
JWT_SECRET=cambia_este_secreto_en_produccion

# Tiempo de expiración del token
JWT_EXPIRES_IN=1h

# Origen permitido por CORS (el frontend Nginx dentro de Docker)
FRONTEND_ORIGIN=http://localhost:8080

# Ruta de la base de datos SQLite (relativa al workdir del contenedor)
DATABASE_PATH=backend/data/donaciones.sqlite

# Credenciales del administrador inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esta_password
