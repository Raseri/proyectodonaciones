PORT=3000
# Opcional en desarrollo local: si se omite, se usa una clave local predeterminada.
# En producción JWT_SECRET es obligatorio y debe ser un secreto seguro.
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=backend/data/donaciones.sqlite

# Opcional: crea un administrador al iniciar si todavía no existe.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
